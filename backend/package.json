{
  "name": "yencloud-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:generate": "prisma generate",
    "lint": "eslint . --ignore-pattern node_modules",
    "format": "prettier --write \"**/*.{js,mjs,cjs}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.808.0",
    "@aws-sdk/client-ssm": "^3.808.0",
    "@prisma/client": "^6.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.0",
    "prisma": "^6.6.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "vitest": "^1.6.1"
  }
}
