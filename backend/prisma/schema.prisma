generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  description   String
  originalPrice Float
  salePrice     Float?
  stock         Int      @default(0)
  images        String[]
  category      String
  rating        Float    @default(0)
  featured      Boolean  @default(false)
  barcode       String?  @unique
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              Int         @id @default(autoincrement())
  orderId         String      @unique
  items           Json
  status          OrderStatus @default(PENDING)
  total           Float
  customerName    String
  customerEmail   String
  shippingAddress Json
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  refunds         Refund[]
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
}

model Refund {
  id         Int          @id @default(autoincrement())
  orderId    Int
  order      Order        @relation(fields: [orderId], references: [id])
  reason     String
  status     RefundStatus @default(REQUESTED)
  adminNotes String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([orderId])
}
